{
  "id": "download-music",
  "name": "Music Download",
  "version": "0.2.0",
  "minAppVersion": "0.1.8",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "flac.music.hi.cn",
      "*.music.126.net",
      "*.126.net",
      "music.163.com",
      "*.kuwo.cn",
      "kuwo.cn",
      "www.kuwo.cn"
    ]
  },
  "settings": [
    {
      "key": "quality",
      "label": "Download quality (lossless / high / standard)",
      "help": "默认无损：优先 FLAC，没有 FLAC 时自动回退到最高音质 MP3(320)。可改为 high(MP3 320) 或 standard(MP3 128)。"
    }
  ],
  "navigation": [
    { "title": "Charts", "page": "charts", "icon": "star" }
  ]
}
