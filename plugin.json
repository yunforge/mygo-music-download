{
  "id": "flac-music",
  "name": "FLAC 无损音乐",
  "version": "1.0.0",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "flac.music.hi.cn",
      "*.music.126.net",
      "*.126.net",
      "music.163.com",
      "*.kuwo.cn",
      "kuwo.cn",
      "www.kuwo.cn"
    ]
  },
  "settings": [
    {
      "key": "platform",
      "label": "搜索来源 (wyy / kuwo / all)",
      "help": "wyy = 网易云音乐，kuwo = 酷我音乐，all = 两站合并。留空默认 all。",
      "link": "https://flac.music.hi.cn/"
    }
  ],
  "navigation": [
    { "builtin": "home" },
    { "title": "榜单", "page": "charts", "icon": "star" }
  ]
}
